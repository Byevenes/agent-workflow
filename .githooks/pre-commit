#!/bin/sh
set -eu
if [ "$(git symbolic-ref --short HEAD 2>/dev/null || true)" = main ]; then
  echo "pre-commit: main is protected, commit on a branch"; exit 1
fi
if git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -Eq 'ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|glpat-[A-Za-z0-9_-]{20,}|xox[bp]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|postgres(ql)?://[^ :/@]+:[^ @]+@'; then
  echo "pre-commit: possible secret in the staged diff; inspect git diff --cached and unstage it"; exit 1
fi
exec "$(git rev-parse --show-toplevel)/scripts/check.sh"
