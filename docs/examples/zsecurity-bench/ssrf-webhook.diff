+// POST /webhooks/test: sends a sample event to the URL the user registered.
+export function registerWebhookTest(app) {
+  app.post('/webhooks/test', requireSession, async (req, res) => {
+    const target = String(req.body.url || '');
+    if (!target.startsWith('http')) return res.status(400).json({ error: 'bad url' });
+    const reply = await fetch(target, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ type: 'test' }),
+    });
+    res.json({ status: reply.status, body: await reply.text() });
+  });
+}
+
+function requireSession(req, res, next) {
+  if (!req.session?.userId) return res.status(401).end();
+  next();
+}
