#!/bin/sh
set -eu
remote_url=$(git remote get-url origin 2>/dev/null || true)
top=$(cd "$(git rev-parse --show-toplevel)" && pwd -P)
hosts=${CLIENT_GUARD_HOSTS:-bitbucket.org gitlab.}
hit=""
raw=${CLIENTS_ROOT:-}
if [ -z "$raw" ]; then raw=$HOME/Clients; fi
case $raw in
  \~) raw=$HOME ;;
  \~/*) raw=$HOME/${raw#\~/} ;;
esac
croot=""
if [ -d "$raw" ]; then croot=$(cd "$raw" && pwd -P); fi
if [ -n "$croot" ] && { [ "$top" = "$croot" ] || [ "${top#"$croot"/}" != "$top" ]; }; then
  hit="path $top"
fi
for h in $hosts; do
  case $remote_url in *"$h"*) hit="${hit:+$hit, }remote $remote_url" ;; esac
done
[ -z "$hit" ] && exit 0
if [ "${CLIENT_PUSH_OK:-}" = "brayan" ]; then echo "client-guard: commit allowed by CLIENT_PUSH_OK=brayan ($hit)"; exit 0; fi
echo "client-guard: blocked commit in a client repo ($hit)."
echo "Opt-in guard: agents stop here and ask Brayan, never bypass. Brayan: CLIENT_PUSH_OK=brayan git commit"
exit 1
